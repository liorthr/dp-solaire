# --- Toutes optionnelles : l'application fonctionne sans (mode démo statique) ---
# Cible de build : "static" (GitHub Pages / CDN, défini par npm run build:static) ou serveur (next build / Vercel)
# DEPLOY_TARGET=static
# Sous-chemin de publication (GitHub Pages : /<nom-du-dépôt>)
NEXT_PUBLIC_BASE_PATH=
# live (défaut) | fixtures (réponses API enregistrées, démo hors ligne)
NEXT_PUBLIC_PROVIDER_MODE=live

# --- Mode serveur (Vercel) ---
# IA (lecture du PLU, analyse des courriers) : https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Envoi d'email (Resend)
RESEND_API_KEY=
MAIL_FROM="DP Solaire <depot@votre-domaine.fr>"
# Stripe (mode test uniquement en V1)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_ENTREPRISE=price_xxx
# Supabase (driver serveur à venir ; schéma prêt dans supabase/migrations)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
